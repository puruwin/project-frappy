---
import { site } from "../data/site";
interface Props {
  formId?: string;
}
const { formId = "contact-form" } = Astro.props;
---

<form
  class="contact-form"
  id={formId}
  action={site.formEndpoint}
  method="POST"
  data-contact-form
  data-location="form"
>
  <div class="form-grid">
    <label class="field" for={`${formId}-name`}
      >Nombre<input
        id={`${formId}-name`}
        name="name"
        autocomplete="name"
        required
        maxlength="120"
      /></label
    >
    <label class="field" for={`${formId}-company`}
      >Empresa <small>(opcional)</small><input
        id={`${formId}-company`}
        name="company"
        autocomplete="organization"
        maxlength="160"
      /></label
    >
    <label class="field field-full" for={`${formId}-contact`}
      >Email o teléfono<input
        id={`${formId}-contact`}
        name="contact"
        type="text"
        required
        maxlength="180"
        aria-describedby={`${formId}-contact-help`}
      /><small id={`${formId}-contact-help`}
        >Elige cómo prefieres que te responda.</small
      ></label
    >
    <label class="field field-full" for={`${formId}-message`}
      >¿Qué está ocurriendo?<textarea
        id={`${formId}-message`}
        name="message"
        rows="4"
        required
        maxlength="5000"></textarea></label
    >
  </div>
  <div class="honeypot" aria-hidden="true">
    <label
      >No rellenes este campo<input
        name="_gotcha"
        tabindex="-1"
        autocomplete="off"
      /></label
    >
  </div>
  <input type="hidden" name="page_path" value={Astro.url.pathname} />
  <label class="privacy-check"
    ><input type="checkbox" name="privacy" required /><span
      >He leído y acepto la <a href="/privacidad/">política de privacidad</a> para
      atender mi consulta.</span
    ></label
  >
  <button class="button button-light" type="submit"
    >Cuéntame el problema <span aria-hidden="true">↗</span></button
  >
  <p class="form-status" role="status" aria-live="polite" tabindex="-1"></p>
</form>
<script>
  import "../scripts/contact";
</script>
