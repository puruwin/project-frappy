---
import { site, navigation } from "../data/site";
import { solutions } from "../data/solutions";
---

<footer class="site-footer" data-location="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/"
          >frappé <small>tech</small><span class="sr-only">, inicio</span></a
        ><p>
          Un estudio independiente. Una conversación directa. Tecnología al
          servicio de tu negocio.
        </p>
      </div>
      <div class="footer-links">
        <strong>Explora</strong>{
          navigation.map((item) => <a href={item.href}>{item.label}</a>)
        }<a href="/blog">Blog</a>{
          solutions.map((s) => <a href={`/soluciones/${s.slug}`}>{s.name}</a>)
        }
      </div>
      <div class="footer-links">
        <strong>Hablemos de tu negocio</strong><a href={`mailto:${site.email}`}
          >{site.email}</a
        ><a href={`tel:${site.phone}`}>{site.phoneLabel}</a><a
          href={site.whatsapp}
          target="_blank"
          rel="noopener noreferrer">Escríbeme por WhatsApp ↗</a
        ><p>Desde Benidorm, trabajando contigo estés donde estés.</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} Frappé Tech · David Pérez</p><div>
        <a href="/privacidad">Privacidad</a><button
          type="button"
          data-cookie-settings>Preferencias de cookies</button
        >
      </div>
    </div>
  </div>
</footer>
