---
// Reserved for future packages. No published prices or dependencies on contact modals.
interface Props {
  title: string;
  price: string;
  description: string;
  features: string[];
}
const { title, price, description, features } = Astro.props;
---

<article class="solution">
  <h3>{title}</h3><p>{description}</p><p><strong>{price}</strong></p><ul>
    {features.map((feature) => <li>{feature}</li>)}
  </ul><a class="text-link" href="/contacto/">Consultar este servicio ↗</a>
</article>
