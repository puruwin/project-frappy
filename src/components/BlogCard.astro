---
import { Image } from "astro:assets";
import type { BlogPost } from "../utils/blog";
import { formatDate } from "../utils/blog";
import { blogImages, blogDescriptions } from "../data/blog";
interface Props {
  post: BlogPost;
}
const { post } = Astro.props;
const image = blogImages[post.frontmatter.image || ""];
const description = blogDescriptions[post.url] || post.frontmatter.description;
---

<article class="blog-card">
  {
    image && (
      <Image
        src={image}
        alt=""
        widths={[360, 600, 900]}
        sizes="(max-width: 760px) 90vw, 30vw"
        format="webp"
        loading="lazy"
      />
    )
  }<time
    class="blog-meta"
    datetime={new Date(post.frontmatter.date).toISOString()}
    >{formatDate(post.frontmatter.date)}</time
  ><h2><a href={post.url}>{post.frontmatter.title}</a></h2><p>
    {description}
  </p><a class="text-link" href={post.url}
    >Leer artículo <span class="sr-only">: {post.frontmatter.title}</span> ↗</a
  >
</article>
