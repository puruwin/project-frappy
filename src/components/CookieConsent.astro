<section
  class="cookie-banner"
  id="cookie-consent"
  aria-labelledby="cookie-title"
  hidden
  tabindex="-1"
>
  <strong id="cookie-title">Tú decides sobre las cookies</strong>
  <p>
    Con tu permiso, utilizo analítica para entender qué páginas ayudan a iniciar
    conversaciones. Puedes navegar y contactar sin aceptarla. <a
      href="/privacidad#cookies">Cómo uso las cookies</a
    >.
  </p>
  <div class="actions">
    <button class="button" type="button" data-consent="accepted"
      >Aceptar analítica</button
    ><button class="button button-outline" type="button" data-consent="rejected"
      >Rechazar</button
    >
  </div>
</section>
