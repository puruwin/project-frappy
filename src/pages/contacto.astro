---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";
import { breadcrumbSchema } from "../utils/schema";
---

<Layout
  title="Cuéntame qué está fallando en tu negocio | Frappé Tech"
  description="Habla directamente con David. Cuéntame qué te hace perder tiempo o clientes y veremos cómo resolverlo. Formulario, WhatsApp o email."
  schema={breadcrumbSchema([{ name: "Contacto", path: "/contacto" }])}
>
  <section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ name: "Contacto" }]} /><span class="eyebrow"
        >Hablemos</span
      ><h1>No necesitas saber<br />qué tecnología necesitas.</h1><p
        class="lead"
      >
        Cuéntame qué está pasando. Soy David: te ayudaré a entender qué se puede
        mejorar y, si encaja, te prepararé una propuesta con alcance y precio
        claros.
      </p>
    </div>
  </section>
  <section class="section contact-section" data-location="contact-page">
    <div class="wrap split">
      <div>
        <h2>¿Qué te está haciendo perder tiempo o clientes?</h2><p class="lead">
          Puedes empezar con algo sencillo: cómo trabajáis ahora, dónde se
          atasca el proceso y qué te gustaría cambiar.
        </p><div class="actions">
          <a
            class="text-link"
            href={site.whatsapp}
            target="_blank"
            rel="noopener noreferrer">Escríbeme por WhatsApp ↗</a
          ><a class="text-link" href={`mailto:${site.email}`}
            >Prefiero un email ↗</a
          >
        </div><p style="margin-top:24px">
          También puedes llamar al <a
            class="text-link"
            href={`tel:${site.phone}`}>{site.phoneLabel}</a
          >.
        </p>
      </div><ContactForm />
    </div>
  </section>
</Layout>
