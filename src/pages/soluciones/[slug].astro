---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CTASection from "../../components/CTASection.astro";
import CaseStudyPreview from "../../components/CaseStudyPreview.astro";
import { solutions } from "../../data/solutions";
import { projects } from "../../data/projects";
import { breadcrumbSchema, serviceSchema } from "../../utils/schema";
export function getStaticPaths() {
  return solutions.map((solution) => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}
const { solution } = Astro.props;
const path = `/soluciones/${solution.slug}`;
const cases = projects.filter((project) =>
  solution.projectSlugs.includes(project.slug),
);
const schemas = [
  breadcrumbSchema([{ name: solution.name, path }]),
  serviceSchema(solution.name, solution.description, path),
];
---

<Layout
  title={`${solution.name}: ${solution.tagline} | Frappé Tech`}
  description={solution.description}
  schema={schemas}
  viewEvent="solution_view"
  viewId={solution.slug}
>
  <section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ name: solution.name }]} /><span class="eyebrow"
        >{solution.number} / {solution.name}</span
      ><h1>{solution.tagline}</h1><p class="lead">{solution.description}</p><div
        class="actions"
      >
        <a class="button" href="/contacto/">Cuéntame qué está fallando ↗</a>
      </div>
    </div>
  </section>
  <section class="section section-tint">
    <div class="wrap split">
      <h2>Puede que estés<br />en este punto.</h2><ul class="problem-list">
        {solution.problems.map((problem) => <li>{problem}</li>)}
      </ul>
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Qué podemos resolver</span><h2>
          Un alcance ajustado<br />a tu negocio.
        </h2><p class="lead" style="margin-top:24px">{solution.boundary}</p>
      </div><ul class="editorial-list">
        {
          solution.includes.map((item) => (
            <li>
              <>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </>
            </li>
          ))
        }
      </ul>
    </div><div class="wrap">
      <div class="example">
        <p>{solution.example}</p><p>
          <strong>Presupuesto cerrado antes de empezar.</strong> Definimos prioridades,
          alcance y plazo antes de construir.
        </p>
      </div>
    </div>
  </section>
  {
    cases.length > 0 && (
      <section class="section section-tint">
        <div class="wrap">
          <div class="section-heading">
            <h2>
              Así toma forma
              <br />
              en un negocio real.
            </h2>
          </div>
          {cases.map((project) => (
            <CaseStudyPreview {project} />
          ))}
        </div>
      </section>
    )
  }
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">¿El problema está en otro lugar?</span><div
        class="actions"
      >
        {
          solutions
            .filter((item) => item.slug !== solution.slug)
            .map((item) => (
              <a class="text-link" href={`/soluciones/${item.slug}/`}>
                {item.name}: {item.tagline} ↗
              </a>
            ))
        }
      </div>
    </div>
  </section>
  <CTASection />
</Layout>
