    <!-- Script del formulario con webhook -->
    <script>
      // @ts-nocheck
      // ⚠️ CONFIGURA AQUÍ TU WEBHOOK DE MAKE
      const WEBHOOK_URL = "https://hook.eu1.make.com/n5a8nl6djnrkykfecs4cdiovambi0s85";
      // Opcional: si en Make activaste "API key authentication", ponla aquí.
      // Nota: si la pones en frontend, será visible públicamente.
      const WEBHOOK_API_KEY = "";

      const form = document.getElementById("webhookForm");
      const submitButton = document.getElementById("webhookSubmitButton");
      const requiredInputs = form?.querySelectorAll("input[required], textarea[required]");

      // Validación en tiempo real
      const checkFormValidity = () => {
        if (!requiredInputs) return false;
        const privacyCheckbox = document.getElementById("form-privacy");
        const fieldsValid = Array.from(requiredInputs).every(
          (input) => input.value.trim() !== ""
        );
        const privacyValid = privacyCheckbox?.checked ?? false;
        return fieldsValid && privacyValid;
      };

      requiredInputs?.forEach((input) => {
        input.addEventListener("input", () => {
          if (submitButton) submitButton.disabled = !checkFormValidity();
        });
      });

      const privacyCheckbox = document.getElementById("form-privacy");
      privacyCheckbox?.addEventListener("change", () => {
        if (submitButton) submitButton.disabled = !checkFormValidity();
      });

      // Envío del formulario
      form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (!submitButton) return;
        submitButton.disabled = true;
        submitButton.textContent = "Enviando...";

        // Recoger datos del formulario
        const formData = {
          name: document.getElementById("form-name")?.value?.trim() || "",
          email: document.getElementById("form-email")?.value?.trim() || "",
          phone: document.getElementById("form-phone")?.value?.trim() || "",
          company: document.getElementById("form-company")?.value?.trim() || "",
          message: document.getElementById("form-message")?.value?.trim() || "",
          source: "Landing Automatización IA",
          timestamp: new Date().toISOString(),
          page_url: window.location.href,
        };

        try {
          const headers = {
            "Content-Type": "application/json",
          };
          if (WEBHOOK_API_KEY) {
            headers["X-Make-ApiKey"] = WEBHOOK_API_KEY;
          }

          const response = await fetch(WEBHOOK_URL, {
            method: "POST",
            headers,
            body: JSON.stringify(formData),
          });

          if (!response.ok) {
            const bodyText = await response.text().catch(() => "");
            throw new Error(`Webhook error (${response.status}): ${bodyText || response.statusText}`);
          }

          form.reset();
          document.getElementById("successModal")?.classList.remove("hidden");
          submitButton.disabled = true;

          // Analytics (si tienes GTM/dataLayer)
          window.dataLayer?.push({
            event: "form_submit",
            form_name: "webhookForm",
            form_status: "success",
          });
        } catch (error) {
          console.error("Error enviando formulario:", error);
          document.getElementById("errorModal")?.classList.remove("hidden");
          submitButton.disabled = false;

          window.dataLayer?.push({
            event: "form_submit",
            form_name: "webhookForm",
            form_status: "error",
          });
        } finally {
          submitButton.textContent = "Solicitar consultoría gratuita";
        }
      });
    </script>

