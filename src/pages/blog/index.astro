---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BlogCard from "../../components/BlogCard.astro";
import CTASection from "../../components/CTASection.astro";
import { getAllPosts, getAllTags } from "../../utils/blog";
import { breadcrumbSchema } from "../../utils/schema";
const posts = await getAllPosts();
const tags = getAllTags(posts);
---

<Layout
  title="Ideas para decidir mejor sobre tu web y tu negocio | Blog Frappé Tech"
  description="Artículos de David sobre presencia online y decisiones digitales para pequeños negocios. Explicaciones claras, sin tecnicismos innecesarios."
  schema={breadcrumbSchema([{ name: "Blog", path: "/blog" }])}
>
  <section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ name: "Blog" }]} /><span class="eyebrow"
        >Ideas y criterio</span
      ><h1>Entender antes<br />de decidir.</h1><p class="lead">
        Notas sobre webs, negocios y decisiones digitales. Para saber qué
        necesitas y qué puedes dejar para después.
      </p><div class="tag-list" aria-label="Filtrar artículos por tema">
        <button class="tag" data-tag="all" aria-pressed="true">Todos</button>{
          tags.map((tag) => (
            <button class="tag" data-tag={tag} aria-pressed="false">
              {tag}
            </button>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="blog-grid">
        {
          posts.map((post) => (
            <div data-post-tags={JSON.stringify(post.frontmatter.tags)}>
              <BlogCard {post} />
            </div>
          ))
        }
      </div><p id="empty-posts" hidden role="status">
        No hay artículos con este tema. Prueba otro filtro.
      </p>
    </div>
  </section><CTASection />
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-tag]");
    function filter(tag: string) {
      let count = 0;
      buttons.forEach((button) =>
        button.setAttribute("aria-pressed", String(button.dataset.tag === tag)),
      );
      document
        .querySelectorAll<HTMLElement>("[data-post-tags]")
        .forEach((post) => {
          const tags: string[] = JSON.parse(post.dataset.postTags || "[]");
          post.hidden = tag !== "all" && !tags.includes(tag);
          if (!post.hidden) count++;
        });
      document.getElementById("empty-posts")!.hidden = count > 0;
    }
    const initial = new URLSearchParams(location.search).get("tag");
    if (initial) filter(initial);
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        const tag = button.dataset.tag || "all";
        filter(tag);
        const url = new URL(location.href);
        if (tag === "all") url.searchParams.delete("tag");
        else url.searchParams.set("tag", tag);
        history.replaceState(null, "", url);
      }),
    );
  </script>
</Layout>
