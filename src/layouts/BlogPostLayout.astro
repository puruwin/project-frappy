---
import Layout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CTASection from "../components/CTASection.astro";
import BlogCard from "../components/BlogCard.astro";
import { Image } from "astro:assets";
import {
  getAllPosts,
  getRelatedPosts,
  formatDate,
  type BlogPost,
} from "../utils/blog";
import { blogImages, blogDescriptions } from "../data/blog";
import { breadcrumbSchema } from "../utils/schema";
import { site } from "../data/site";
interface Props {
  frontmatter: BlogPost["frontmatter"];
}
const {
  title,
  description,
  image,
  date,
  author,
  tags = [],
} = Astro.props.frontmatter;
const url = Astro.url.pathname.replace(/\/$/, "");
const posts = await getAllPosts();
const current = posts.find((post) => post.url === url)!;
const related = getRelatedPosts(current, posts, 2);
const photo = blogImages[image || ""];
const summary = blogDescriptions[url] || description;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: summary,
  datePublished: new Date(date).toISOString(),
  author: { "@type": "Person", name: author },
  publisher: { "@id": `${site.url}/#organization` },
  mainEntityOfPage: new URL(url, site.url).href,
  ...(image ? { image: new URL(image, site.url).href } : {}),
};
---

<Layout
  title={`${title} | Blog Frappé Tech`}
  description={summary}
  image={image}
  ogType="article"
  schema={[
    articleSchema,
    breadcrumbSchema([
      { name: "Blog", path: "/blog" },
      { name: title, path: url },
    ]),
  ]}
>
  <section class="page-hero">
    <div class="wrap">
      <Breadcrumbs
        items={[{ name: "Blog", href: "/blog" }, { name: title }]}
      /><span class="eyebrow">Ideas y criterio</span><h1>{title}</h1><p
        class="blog-meta"
      >
        {author} · <time datetime={new Date(date).toISOString()}
          >{formatDate(date)}</time
        >
      </p><div class="tag-list">
        {
          tags.map((tag) => (
            <a class="tag" href={`/blog?tag=${encodeURIComponent(tag)}`}>
              {tag}
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <article class="wrap" style="padding-bottom:70px">
    {
      photo && (
        <Image
          class="article-image"
          src={photo}
          alt=""
          widths={[600, 1152]}
          sizes="(max-width: 760px) 90vw, 768px"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      )
    }<div class="prose"><slot /></div>
  </article>
  {
    related.length > 0 && (
      <section class="section section-tint">
        <div class="wrap">
          <>
            <div class="section-heading">
              <h2>También puede ayudarte.</h2>
            </div>
            <div class="blog-grid">
              {related.map((post) => (
                <BlogCard {post} />
              ))}
            </div>
          </>
        </div>
      </section>
    )
  }
  <CTASection />
</Layout>
