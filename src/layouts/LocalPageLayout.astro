---
import Layout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CTASection from "../components/CTASection.astro";
import CaseStudyPreview from "../components/CaseStudyPreview.astro";
import type { LocalPage } from "../data/local-pages";
import { projects } from "../data/projects";
import { breadcrumbSchema, serviceSchema } from "../utils/schema";
interface Props {
  page: LocalPage;
}
const { page } = Astro.props;
const project = projects.find((p) => p.slug === page.projectSlug)!;
---

<Layout
  title={`${page.title} | Frappé Tech`}
  description={page.description}
  schema={[
    breadcrumbSchema([{ name: page.title, path: `/${page.slug}` }]),
    serviceSchema(page.title, page.description, `/${page.slug}`),
  ]}
>
  <section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ name: page.title }]} /><span class="eyebrow"
        >{page.eyebrow}</span
      ><h1>{page.heading}</h1><p class="lead">{page.intro}</p><div
        class="actions"
      >
        <a class="button" href="#contacto">Cuéntame qué necesitas ↗</a>
      </div>
    </div>
  </section>
  <section class="section section-tint">
    <div class="wrap split">
      <h2>Empezamos por<br />lo que falta.</h2><ul class="problem-list">
        {page.problems.map((problem) => <li>{problem}</li>)}
      </ul>
    </div>
  </section>
  <section class="section">
    <div class="wrap detail-grid">
      {
        page.sections.map((section) => (
          <section class="detail-block">
            <>
              <h2>{section.title}</h2>
              <p>{section.text}</p>
            </>
          </section>
        ))
      }
    </div><div class="wrap">
      <p class="budget-note">
        <strong>Presupuesto cerrado antes de empezar.</strong> Definimos juntos alcance,
        precio y plazo.
      </p><a class="text-link" href="/soluciones/presencia-digital"
        >Más sobre presencia digital ↗</a
      ><br /><a class="text-link" href="/soluciones/automatizacion"
        >Si el problema está en las tareas repetitivas ↗</a
      >
    </div>
  </section>
  <section class="section section-tint">
    <div class="wrap">
      <div class="section-heading"><h2>Un caso real.</h2></div><CaseStudyPreview
        {project}
      />
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <h2>Antes de empezar.</h2><div class="faq">
        {
          page.faqs.map((faq) => (
            <details>
              <>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </>
            </details>
          ))
        }
      </div>
    </div>
  </section><CTASection form />
</Layout>
